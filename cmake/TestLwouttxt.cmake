# Exercise namelist reading, initialization and both output modes with a
# published low-resolution input. Each invocation owns its output directory.
file(MAKE_DIRECTORY "${TEST_DIRECTORY}")
file(READ "${INPUT_FILE}" input)
if(TEXT_OUTPUT)
    set(flag T)
else()
    set(flag F)
endif()
string(REPLACE "LWOUTTXT=T" "LWOUTTXT=${flag}" input "${input}")
file(WRITE "${TEST_DIRECTORY}/input.li383_low_res" "${input}")
file(REMOVE "${TEST_DIRECTORY}/wout_li383_low_res.txt"
            "${TEST_DIRECTORY}/wout_li383_low_res.nc")
execute_process(COMMAND "${VMEC_EXECUTABLE}" input.li383_low_res
    WORKING_DIRECTORY "${TEST_DIRECTORY}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${TEST_DIRECTORY}/run.log" "${output}\n${error}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "VMEC failed (${result}); see ${TEST_DIRECTORY}/run.log")
endif()
if(NOT EXISTS "${TEST_DIRECTORY}/wout_li383_low_res.nc")
    message(FATAL_ERROR "VMEC did not write its native netCDF output")
endif()
set(text "${TEST_DIRECTORY}/wout_li383_low_res.txt")
if(TEXT_OUTPUT)
    if(NOT EXISTS "${text}")
        message(FATAL_ERROR "LWOUTTXT=T did not produce text output")
    endif()
    file(STRINGS "${text}" header LIMIT_COUNT 1)
    if(NOT header MATCHES "VMEC VERSION")
        message(FATAL_ERROR "Text output lacks the native VMEC header")
    endif()
elseif(EXISTS "${text}")
    message(FATAL_ERROR "LWOUTTXT=F unexpectedly produced text output")
endif()
